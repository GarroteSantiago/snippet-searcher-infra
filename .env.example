# Copiar a .env. docker compose lo lee solo; .env no se commitea.

# Imágenes publicadas por CI (ghcr.io/<owner>/<servicio>:<TAG>)
REGISTRY=ghcr.io/<owner>
TAG=dev

# Puerto de NGINX en la máquina (con el login local, distinto de 80)
HTTP_PORT=80

# Auth0 (docker-compose.local-auth.yml los pisa con el login local)
AUTH0_ISSUER_URI=https://<tenant>.auth0.com/
AUTH0_AUDIENCE=https://snippet-searcher/api
# Token client credentials de las llamadas sin usuario: app machine-to-machine autorizada para
# AUTH0_AUDIENCE. AUTH0_TOKEN_URI es opcional (por defecto ${AUTH0_ISSUER_URI}oauth/token).
AUTH0_TOKEN_URI=
AUTH0_SERVICE_CLIENT_ID=
AUTH0_SERVICE_CLIENT_SECRET=

# Postgres: superusuario y un usuario por servicio
POSTGRES_PASSWORD=change-me
SNIPPET_DB_PASSWORD=change-me-snippet
PERMISSION_DB_PASSWORD=change-me-permission

# Auth0 Management API (app machine-to-machine con read:users), para compartir snippets
AUTH0_DOMAIN=<tenant>.auth0.com
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# Observabilidad: logs en json (o plain) y New Relic, apagado hasta tener la license key
LOG_FORMAT=json
NEW_RELIC_ENABLED=false
NEW_RELIC_LICENSE_KEY=
# Región EU: https://otlp.eu01.nr-data.net/v1/metrics
NEW_RELIC_OTLP_URL=https://otlp.nr-data.net/v1/metrics
