meta {
  name: Crear snippet válido
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/snippets
  body: json
  auth: inherit
}

body:json {
  {
    "name": "saludo",
    "description": "Saluda a quien lo corre",
    "language": "printscript",
    "version": "1.1",
    "extension": "ps",
    "content": "let nombreUsuario: string = readInput(\"Nombre\");\nlet saludo: string = \"Hola \" + nombreUsuario;\nprintln(saludo);"
  }
}

script:post-response {
  bru.setVar("snippetId", res.body.id)
}

tests {
  test("201, del dueño y pendiente de lint", () => {
    expect(res.status).to.equal(201)
    expect(res.body.id).to.be.a("string")
    expect(res.body.relation).to.equal("owned")
    expect(res.body.authorId).to.equal(bru.getVar("ownerId"))
    expect(res.body.compliance).to.equal("pending")
  })
}
