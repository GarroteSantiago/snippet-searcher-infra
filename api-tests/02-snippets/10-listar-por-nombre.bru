meta {
  name: Listar filtrando por nombre
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/snippets?name=no-existe
  body: none
  auth: inherit
}

tests {
  test("200 sin resultados", () => {
    expect(res.status).to.equal(200)
    expect(res.body.count).to.equal(0)
    expect(res.body.snippets).to.eql([])
  })
}
