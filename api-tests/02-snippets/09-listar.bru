meta {
  name: Listar snippets
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/snippets?page=0&page_size=10
  body: none
  auth: inherit
}

tests {
  test("200 con el snippet y la paginación", () => {
    expect(res.status).to.equal(200)
    expect(res.body.page).to.equal(0)
    expect(res.body.page_size).to.equal(10)
    expect(res.body.count).to.equal(1)
    expect(res.body.snippets[0].id).to.equal(bru.getVar("snippetId"))
  })
}
