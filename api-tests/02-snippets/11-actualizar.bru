meta {
  name: Actualizar el contenido
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/snippets/{{snippetId}}
  body: json
  auth: inherit
}

body:json {
  {
    "content": "let nombreUsuario: string = readInput(\"Nombre\");\nlet saludo: string = \"Hola \" + nombreUsuario;\nprintln(saludo);\nprintln(\"fin\");"
  }
}

tests {
  test("200 con el contenido nuevo", () => {
    expect(res.status).to.equal(200)
    expect(res.body.content).to.contain("fin")
  })
}
