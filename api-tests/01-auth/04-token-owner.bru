meta {
  name: Token del dueño
  type: http
  seq: 4
}

post {
  url: {{authUrl}}/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  username: owner-{{runId}}
  password: local
  client_id: api-tests
  audience: {{audience}}
}

script:pre-request {
  // Usuarios nuevos en cada corrida: el login local acepta cualquier nombre
  bru.setVar("runId", Date.now().toString(36))
}

script:post-response {
  bru.setVar("ownerToken", res.body.access_token)
  bru.setVar("ownerId", "auth0|owner-" + bru.getVar("runId"))
  bru.setVar("readerId", "auth0|reader-" + bru.getVar("runId"))
}

tests {
  test("200 con access token", () => {
    expect(res.status).to.equal(200)
    expect(res.body.access_token).to.be.a("string")
  })
}
