meta {
  name: Token del lector
  type: http
  seq: 5
}

post {
  url: {{authUrl}}/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  username: reader-{{runId}}
  password: local
  client_id: api-tests
  audience: {{audience}}
}

script:post-response {
  bru.setVar("readerToken", res.body.access_token)
}

tests {
  test("200 con access token", () => {
    expect(res.status).to.equal(200)
    expect(res.body.access_token).to.be.a("string")
  })
}
