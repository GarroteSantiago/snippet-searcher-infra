meta {
  name: Formatear con las reglas por defecto
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/format
  body: json
  auth: inherit
}

body:json {
  {
    "content": "let a:number=1;println(a);",
    "language": "printscript",
    "version": "1.1"
  }
}

tests {
  test("200 formateado", () => {
    expect(res.status).to.equal(200)
    expect(res.body.content).to.equal("let a: number = 1;\nprintln(a);")
  })
}
