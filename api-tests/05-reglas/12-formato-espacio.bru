meta {
  name: Activar el espacio antes de los dos puntos
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/rules/format
  body: json
  auth: inherit
}

body:json {
  []
}

tests {
  test("202", () => expect(res.status).to.equal(202))
}

script:pre-request {
  // El PUT lleva la lista completa: se toma la actual y se cambia una regla
  const axios = require("axios")
  const headers = {Authorization: "Bearer " + bru.getVar("ownerToken")}
  const rules = (await axios.get(bru.getEnvVar("baseUrl") + "/rules/format", {headers})).data
  rules.find(r => r.id === "enforce-spacing-before-colon-in-declaration").isActive = true
  req.setBody(rules)
}
