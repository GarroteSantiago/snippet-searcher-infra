meta {
  name: Reglas de formato por defecto
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/rules/format
  body: none
  auth: inherit
}

tests {
  test("200 sin espacio antes de los dos puntos", () => {
    expect(res.status).to.equal(200)
    expect(res.body.find(r => r.id === "enforce-spacing-before-colon-in-declaration").isActive).to.equal(false)
  })
}
