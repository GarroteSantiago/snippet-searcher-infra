meta {
  name: Volver identifier_format a camel case
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/rules/lint
  body: json
  auth: inherit
}

body:json {
  []
}

tests {
  test("202", () => expect(res.status).to.equal(202))
}

script:pre-request {
  // El PUT lleva la lista completa: se toma la actual y se cambia una regla
  const axios = require("axios")
  const headers = {Authorization: "Bearer " + bru.getVar("ownerToken")}
  const rules = (await axios.get(bru.getEnvVar("baseUrl") + "/rules/lint", {headers})).data
  rules.find(r => r.id === "identifier_format").value = "camel case"
  req.setBody(rules)
}
