meta {
  name: Esperar que vuelva a compliant
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/snippets/{{snippetId}}
  body: none
  auth: inherit
}

tests {
  test("compliant sin violaciones", async () => {
    const axios = require("axios")
    const headers = {Authorization: "Bearer " + bru.getVar("ownerToken")}
    let snippet = res.body
    for (let i = 0; i < 60 && snippet.compliance !== "compliant"; i++) {
      await new Promise(r => setTimeout(r, 250))
      snippet = (await axios.get(req.getUrl(), {headers})).data
    }
    expect(snippet.compliance).to.equal("compliant")
    expect(snippet.lintViolations).to.eql([])
  })
}
