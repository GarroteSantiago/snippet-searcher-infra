meta {
  name: Editar el test que fallaba
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/snippets/{{snippetId}}/tests/{{testFailId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "ahora pasa",
    "input": ["Ana"],
    "output": ["Hola Ana", "fin"]
  }
}

tests {
  test("200 con el output nuevo", () => {
    expect(res.status).to.equal(200)
    expect(res.body.output).to.eql(["Hola Ana", "fin"])
  })
}
