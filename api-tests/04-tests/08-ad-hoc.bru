meta {
  name: Correr un test sin guardarlo
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/snippets/{{snippetId}}/tests/run
  body: json
  auth: inherit
}

body:json {
  {
    "name": "con Beto",
    "input": ["Beto"],
    "output": ["Hola Beto", "fin"]
  }
}

tests {
  test("success y no se guarda", async () => {
    expect(res.status).to.equal(200)
    expect(res.body.status).to.equal("success")
    const axios = require("axios")
    const list = await axios.get(bru.getEnvVar("baseUrl") + "/snippets/" + bru.getVar("snippetId") + "/tests", {headers: {Authorization: "Bearer " + bru.getVar("ownerToken")}})
    expect(list.data).to.have.lengthOf(2)
  })
}
