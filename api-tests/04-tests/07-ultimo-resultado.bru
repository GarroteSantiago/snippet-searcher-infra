meta {
  name: El último resultado queda guardado
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/snippets/{{snippetId}}/tests
  body: none
  auth: inherit
}

tests {
  test("lastResult de cada test", () => {
    const byId = Object.fromEntries(res.body.map(t => [t.id, t.lastResult]))
    expect(byId[bru.getVar("testOkId")]).to.equal("success")
    expect(byId[bru.getVar("testFailId")]).to.equal("fail")
  })
}
