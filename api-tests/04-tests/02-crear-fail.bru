meta {
  name: Crear un test que falla
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/snippets/{{snippetId}}/tests
  body: json
  auth: inherit
}

body:json {
  {
    "name": "espera otra cosa",
    "input": ["Ana"],
    "output": ["Chau Ana"]
  }
}

tests {
  test("201: se pueden guardar tests que fallan", () => expect(res.status).to.equal(201))
}

script:post-response {
  bru.setVar("testFailId", res.body.id)
}
