meta {
  name: Crear un test que pasa
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/snippets/{{snippetId}}/tests
  body: json
  auth: inherit
}

body:json {
  {
    "name": "saluda a Ana",
    "input": ["Ana"],
    "output": ["Hola Ana", "fin"]
  }
}

tests {
  test("201 con id y sin resultado", () => {
    expect(res.status).to.equal(201)
    expect(res.body.id).to.be.a("string")
    expect(res.body.input).to.eql(["Ana"])
    expect(res.body.output).to.eql(["Hola Ana", "fin"])
  })
}

script:post-response {
  bru.setVar("testOkId", res.body.id)
}
