meta {
  name: Borrar un test
  type: http
  seq: 14
}

delete {
  url: {{baseUrl}}/snippets/{{snippetId}}/tests/{{testFailId}}
  body: none
  auth: inherit
}

tests {
  test("204 y queda uno", async () => {
    expect(res.status).to.equal(204)
    const axios = require("axios")
    const list = await axios.get(bru.getEnvVar("baseUrl") + "/snippets/" + bru.getVar("snippetId") + "/tests", {headers: {Authorization: "Bearer " + bru.getVar("ownerToken")}})
    expect(list.data.map(t => t.id)).to.eql([bru.getVar("testOkId")])
  })
}
