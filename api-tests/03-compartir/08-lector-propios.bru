meta {
  name: El lector no tiene snippets propios
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/snippets?relation=owned
  body: none
  auth: bearer
}

auth:bearer {
  token: {{readerToken}}
}

tests {
  test("200 vacío", () => {
    expect(res.status).to.equal(200)
    expect(res.body.count).to.equal(0)
  })
}
