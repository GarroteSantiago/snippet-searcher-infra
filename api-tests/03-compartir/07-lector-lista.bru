meta {
  name: El lector lo ve como compartido
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/snippets?relation=shared
  body: none
  auth: bearer
}

auth:bearer {
  token: {{readerToken}}
}

tests {
  test("200 con relation shared", () => {
    expect(res.status).to.equal(200)
    expect(res.body.count).to.equal(1)
    expect(res.body.snippets[0].id).to.equal(bru.getVar("snippetId"))
    expect(res.body.snippets[0].relation).to.equal("shared")
  })
}
