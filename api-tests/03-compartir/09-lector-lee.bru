meta {
  name: El lector lo lee
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/snippets/{{snippetId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{readerToken}}
}

tests {
  test("200 con el contenido", () => {
    expect(res.status).to.equal(200)
    expect(res.body.content).to.contain("readInput")
    expect(res.body.relation).to.equal("shared")
  })
}
