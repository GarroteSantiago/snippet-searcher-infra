# Puerto 443 (Swarm). Mismo ruteo que nginx/default.conf (compose), pero la UI es su propia
# imagen (printscript-ui) en vez de archivos montados.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Respeta el X-Correlation-Id del cliente si viene; si no, usa el id del request de NGINX
map $http_x_correlation_id $correlation_id {
    default $http_x_correlation_id;
    ''      $request_id;
}

# Los servicios se resuelven por request con el DNS de Docker, no al cargar la config: si un
# servicio todavía no tiene tareas, NGINX arranca (o recarga) igual en vez de fallar
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # API: /api/x -> snippet-service/x (incluye el WebSocket de ejecución en /api/ws/...)
    location /api/ {
        set $snippet_service snippet-service:8080;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$snippet_service;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Correlation-Id $correlation_id;
        proxy_read_timeout 300s;
    }

    location / {
        set $printscript_ui printscript-ui:80;
        proxy_pass http://$printscript_ui;
        proxy_set_header Host $host;
    }
}
