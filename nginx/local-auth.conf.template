# Servidor OIDC de prueba (docker-compose.local-auth.yml). La imagen de NGINX reemplaza las
# variables al arrancar y deja el resultado en conf.d/.
#
# El emisor es http://auth.localhost:${HTTP_PORT}/snippet-searcher, igual desde el navegador
# (que llega por el puerto publicado al 80) y desde los servicios (que resuelven auth.localhost
# a este contenedor y llegan directo a ${HTTP_PORT}). El servidor arma el `iss` con el Host,
# así que se fija acá: el token no depende de quién lo pide.
server {
    listen 80;
    listen ${HTTP_PORT};
    server_name auth.localhost;

    # Resuelve `oidc` en cada pedido (DNS de Docker o de Podman, leído de resolv.conf): si el
    # contenedor se reinicia y cambia de IP, NGINX lo sigue encontrando
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $oidc http://oidc:8080;

    # Management API de Auth0 de mentira, para compartir con el login local (AUTH0_DOMAIN apunta
    # acá). Token: el client credentials del servidor de prueba; nadie lo valida.
    location = /oauth/token {
        proxy_pass $oidc/snippet-searcher/token;
        proxy_set_header Host auth.localhost:${HTTP_PORT};
    }

    # Cualquier nombre puede entrar al login local, así que cualquier auth0|<nombre> existe
    location ~ "^/api/v2/users/(auth0\|[A-Za-z0-9._-]+)$" {
        default_type application/json;
        return 200 '{"user_id":"$1"}';
    }

    location ~ ^/api/v2/users/ {
        default_type application/json;
        return 404 '{"statusCode":404,"error":"Not Found","message":"The user does not exist."}';
    }

    # La búsqueda devuelve siempre los usuarios de los botones del login, sin filtrar por nombre
    location = /api/v2/users {
        default_type application/json;
        return 200 '{"total":2,"users":[{"user_id":"auth0|alice","name":"alice","nickname":"alice","email":"alice@example.com"},{"user_id":"auth0|bob","name":"bob","nickname":"bob","email":"bob@example.com"}]}';
    }

    location / {
        proxy_pass $oidc;
        proxy_set_header Host auth.localhost:${HTTP_PORT};
        proxy_set_header X-Forwarded-Proto http;
    }
}
